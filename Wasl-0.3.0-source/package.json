{
  "name": "wasl-desktop",
  "version": "0.3.0",
  "description": "وصل — منصة عربية مفتوحة المصدر لإنترنت الأشياء على سطح المكتب",
  "author": "Wasl contributors",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit",
    "dist:win": "npm run fetch:cli && npm run build && electron-builder --win zip nsis --x64 --publish never",
    "dist:linux": "npm run fetch:cli && npm run build && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "dist:portable": "node scripts/fetch-cli.mjs --all && npm run build && electron-builder --win zip --linux tar.gz --x64 --publish never",
    "source": "node scripts/source-archive.mjs",
    "fetch:cli": "node scripts/fetch-cli.mjs"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "org.wasl.iot",
    "productName": "Wasl",
    "copyright": "Copyright © 2026 Wasl contributors",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "assets/FONT-LICENSE.txt",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "npmRebuild": false,
    "artifactName": "Wasl-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "Wasl contributors",
      "executableName": "wasl",
      "icon": "assets/icon.png",
      "desktop": {
        "entry": {
          "Name": "Wasl — وصل",
          "Comment": "منصة تطوير إنترنت الأشياء",
          "StartupWMClass": "Wasl"
        }
      }
    },
    "extraResources": [
      {
        "from": "vendor/arduino-cli/${os}-${arch}",
        "to": "arduino-cli",
        "filter": [
          "arduino-cli",
          "arduino-cli.exe",
          "LICENSE.txt",
          "release.json"
        ]
      },
      {
        "from": "vendor/arduino-cli/common",
        "to": "arduino-cli/legal",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
